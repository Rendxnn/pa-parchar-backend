{
  "ConnectionStrings": {
    "PostgreSQLConnection": "Host=localhost;Database=paparchar;Username=postgres;Password=password"
  },
  "GoogleCloudStorage": {
    "BucketName": "paparchar-bucket",
    "CredentialsFilePath": "Config/Keys/gcp_credentials.json"
  },
  "FileStorage": {
    "AllowedMimeTypes": [
      "image/jpeg",
      "image/png",
      "image/gif",
      "image/webp"
    ],
    "MaxFileSize": 5242880,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".webp"
    ],
    "FolderPrefix": "images",
    "UseDateFolders": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
